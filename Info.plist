			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.madhacks.magiboard.object</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.3</string>
	<key>CFBundleVersion</key>
	<string>3</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_magiboard._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connect MagiBoard to your Mac companion for AI canvas actions.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Use your voice to dictate or talk with MagiBoard when you start the microphone.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Understand your spoken instructions for dictation and voice conversation.</string>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
